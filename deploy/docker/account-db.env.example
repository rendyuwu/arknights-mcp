# env_file for the compose `account-db` service (ADR 0020). Copy to account-db.env
# in this directory, replace every value, keep it out of git. Use URL-safe
# passwords (for example `openssl rand -hex 24`): they go into postgresql:// URLs as-is.
POSTGRES_PASSWORD=change-me-admin-example
ARKNIGHTS_ACCOUNT_WRITER_PASSWORD=change-me-writer-example
ARKNIGHTS_ACCOUNT_READER_PASSWORD=change-me-reader-example
