# Sync machine only (your home PC; ADR 0020). `account login` / `account sync`
# write the roster into the server's account-db through an SSH local forward:
#   ssh -N -L 15432:127.0.0.1:5433 <user>@<server>
# Then: uv run --env-file .env arknights-mcp account sync
# This is the WRITER role. Never copy this file to the server.
ARKNIGHTS_MCP_ACCOUNT_DB_URL=postgresql+pg8000://arknights_writer:change-me-writer-example@127.0.0.1:15432/arknights_account
